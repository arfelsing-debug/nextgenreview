  "classification_rules": [
    {
      "key": "established",
      "condition": "mean >= 4.0 and no answered item < 3"
    },
    {
      "key": "developing",
      "condition": "mean >= 3.0 and mean < 4.0"
    },
    {
      "key": "exposed",
      "condition": "mean < 3.0 or any critical item <= 2"
    },
    {
      "key": "unclear",
      "condition": "insufficient answered items or uncertainty density >= 0.375"
    }
